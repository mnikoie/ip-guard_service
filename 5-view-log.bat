@echo off
title IP Guard - Current Status
setlocal
set "IPGUARD_STATUS=C:\ProgramData\IPGuardService\status.json"

powershell -NoProfile -ExecutionPolicy Bypass -Command "$statusFile=$env:IPGUARD_STATUS; while($true){ Clear-Host; Write-Host '============================================' -ForegroundColor DarkGray; Write-Host '         IP Guard - Current Status' -ForegroundColor Cyan; Write-Host '============================================' -ForegroundColor DarkGray; if(-not(Test-Path -LiteralPath $statusFile)){ Write-Host ''; Write-Host 'Service status file is not available yet.' -ForegroundColor Yellow; Write-Host 'Start IPGuardService, then try again.' -ForegroundColor DarkYellow } else { try { $s=Get-Content -LiteralPath $statusFile -Raw -Encoding UTF8 | ConvertFrom-Json; $unsafe=$s.state -eq 'UNSAFE'; $color=if($unsafe){'Red'}else{'Green'}; Write-Host ''; Write-Host ('STATE:   ' + $s.state) -ForegroundColor $color; Write-Host ('IP:      ' + $(if($s.ip){$s.ip}else{'UNKNOWN'})) -ForegroundColor White; Write-Host ('COUNTRY: ' + $(if($s.countryCode){$s.countryCode}else{'UNKNOWN'})) -ForegroundColor White; Write-Host ('UPDATED: ' + $s.updatedAt) -ForegroundColor DarkGray; Write-Host ''; Write-Host 'REASON:' -ForegroundColor Yellow; Write-Host ('  ' + $s.reason) -ForegroundColor $color; Write-Host ''; if($unsafe){ Write-Host 'Protection is active: target apps will be force-closed.' -ForegroundColor Red }else{ Write-Host 'Network is trusted: target apps are allowed to run.' -ForegroundColor Green } } catch { Write-Host ''; Write-Host 'The status file is being updated. Retrying...' -ForegroundColor Yellow } }; Write-Host ''; Write-Host 'Refreshing current status every second. Press Ctrl+C to close.' -ForegroundColor DarkGray; Start-Sleep -Seconds 1 }"
